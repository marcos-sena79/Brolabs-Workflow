{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/index.js": {
      "maxDuration": 30
    }
  },
  "crons": [
    { "path": "/api/cron/process-emails", "schedule": "0 11 * * *" },
    { "path": "/api/cron/cleanup-attachments", "schedule": "0 4 * * *" }
  ],
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index.js" },
    { "source": "/((?!bucket/|assets/).*)", "destination": "/index.html" }
  ]
}
