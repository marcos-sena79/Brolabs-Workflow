# Banco (NeonDB) — obrigatório
DATABASE_URL=postgresql://user:password@host/neondb?sslmode=require

# Auth — obrigatório (gere uma chave: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
JWT_SECRET=
JWT_EXPIRES_IN=24h
BCRYPT_SALT_ROUNDS=12

# Servidor
PORT=3000
NODE_ENV=development
# Origem permitida no CORS (produção). Ex.: https://seu-app.vercel.app
APP_URL=

# Supabase Storage — anexos de tarefas (bucket privado "task-attachments")
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=task-attachments

# Segredo das chamadas de cron (ex.: cleanup de anexos órfãos)
CRON_SECRET=

# SMTP — e-mails reais (item 3.1). Senha SÓ no server, nunca em VITE_
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# IA das notas (item 4.1). Chave SÓ no server, nunca em VITE_
# Provedor ativo: AI_PROVIDER=openrouter|gemini (auto: usa o provedor cuja key existir)
AI_PROVIDER=openrouter
# OpenRouter (https://openrouter.ai/keys) — padrão se AI_PROVIDER=openrouter
OPENROUTER_API_KEY=
# Opcional — modelo OpenRouter (padrão: openai/gpt-4o-mini)
OPENROUTER_MODEL=
# Gemini — alternativa ao OpenRouter
GEMINI_API_KEY=
# Opcional — sobrescreve o modelo padrão (gemini-2.5-flash)
GEMINI_MODEL=

# Webhooks outbound/incoming (S2, item 5)
# Whitelist anti-SSRF: domínios permitidos para envio, separados por vírgula.
# Padrão (sempre ativo): hooks.slack.com, discord.com, discordapp.com, hooks.discord.com, webhook.office.com
# Use para liberar homologação local (ex.: 127.0.0.1) ou domínio próprio.
WEBHOOK_ALLOWED_DOMAINS=
# Segredo HMAC do incoming POST /api/webhooks/incoming (assinar `${timestamp}.${body}` com
# HMAC-SHA256 hex; headers X-Brolabs-Timestamp (epoch s) e X-Brolabs-Signature: sha256=<hex>)
WEBHOOK_INCOMING_SECRET=
